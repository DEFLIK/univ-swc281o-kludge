<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context="com.deflik.univswc281ocrutch.ui.SettingsFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:id="@+id/optionButtonList"
            app:layout_constraintTop_toBottomOf="@+id/topMenu">

        <androidx.constraintlayout.helper.widget.Flow
                app:flow_wrapMode="none"
                app:flow_horizontalGap="20dp"
                app:flow_verticalGap="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="startStopOption,exhaustOption"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:id="@+id/optionsFlow"
                android:layout_marginTop="20dp" />

        <include
                layout="@layout/option_card"
                android:id="@+id/startStopOption"
                android:theme="@style/cardStartStop" />

        <include
                layout="@layout/option_card"
                android:id="@+id/exhaustOption"
                android:theme="@style/cardExhaust" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
            android:id="@+id/connection_loader"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/main_color"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="visible"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/topMenu">

        <ProgressBar
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/active" />

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Подключение к системам автомобиля..."
                android:textColor="@color/main_text"
                android:textSize="34sp" />
    </LinearLayout>

</FrameLayout>