<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.UniVSWC281OCrutch" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
        <item name="fontFamily">@font/app_font_family</item>
    </style>

    <style name="cardStartStop" parent="Theme.UniVSWC281OCrutch">
        <item name="cardHeader">Отключение Start &amp; Stop</item>
        <item name="cardDescription">Автоматическое отключение Start &amp; Stop при запуске ГУ</item>
    </style>
    <style name="cardExhaust" parent="Theme.UniVSWC281OCrutch">
        <item name="cardHeader">Управление заслонками выхлопа</item>
        <item name="cardDescription">Назначает функциональную клавишу руля на управление заслонками выхлопа (Luxe комплектация)</item>
    </style>
    <style name="TopMenuTabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item> <!-- Отключает принудительные заглавные буквы -->
    </style>
</resources>